{
  "name": "orbe-finance",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --lan",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node spikes/access/session.test.mjs && node tests/security/audit-policy.test.mjs && node tests/domain/expenses.test.mjs && node tests/domain/portfolio.test.mjs && node tests/domain/classification.test.mjs && node tests/data/query.test.mjs && node tests/data/demo.test.mjs && node tests/data/overrides.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 tests/admin/backend_admin_test.py && node tests/auth/gateway.test.mjs && node tests/domain/reports.test.mjs && node tests/data/report-route.test.mjs && node tests/auth/session.test.mjs && node tests/auth/lifecycle.test.mjs && node tests/data/ledger.test.mjs && node tests/data/assets.test.mjs && node tests/presentation/money.test.mjs && node tests/data/goals.test.mjs && node tests/data/demo-goals.test.mjs && node tests/domain/references.test.mjs && node tests/security/metro-secrets.test.mjs",
    "export:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios",
    "check": "npm run typecheck && npm test",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "backend:start": "node scripts/local-backend.mjs start",
    "backend:stop": "node scripts/local-backend.mjs stop",
    "backend:status": "node scripts/local-backend.mjs status",
    "backend:cloud:inspect": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py inspect",
    "backend:cloud:bootstrap": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py bootstrap",
    "backend:cloud:migrate": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py migrate",
    "backend:cloud:test-owner": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py test-owner",
    "backend:cloud:set-owner": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py set-owner",
    "backend:cloud:configure-client": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py configure-client",
    "backend:cloud:smoke-auth": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/auth-smoke.py",
    "backend:cloud:test-metadata": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/backend-admin.py test-metadata"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
